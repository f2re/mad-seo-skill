{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Статья MAD-auto",
  "type": "object",
  "required": ["schema_version", "title", "description", "summary", "summary_claim_ids", "sections", "visuals", "author", "cta"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "summary_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sections": {"type": "array", "minItems": 6, "items": {
      "type": "object", "required": ["role", "heading", "text", "claim_ids"],
      "properties": {
        "role": {"enum": ["scope", "requirements", "steps", "result", "troubleshooting", "limitations", "additional"]},
        "heading": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }},
    "visuals": {"type": "array"},
    "author": {"type": "object"},
    "cta": {"type": "string", "minLength": 1},
    "date_published": {"type": ["string", "null"], "format": "date"},
    "date_modified": {"type": ["string", "null"], "format": "date"}
  }
}
